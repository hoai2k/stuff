# Never uploaded by .github/workflows/deploy.yml. The deploy also never
# deletes server files, so anything listed here is left as it is on the server.

# Repo-only files
.git/
.github/
.claude/
.deployignore
.gitignore
*.md

# Server-side data written by cal/api.php
cal/*.json
cal/*.log
cal/*.txt
cal/data/
